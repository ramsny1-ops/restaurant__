{
  "name": "tableflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant QR hospitality ordering MVP with Express, SQLite, EJS and WebSockets.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "dev:node": "node --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "start:bun": "bun src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "node --import tsx scripts/setup.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ejs": "^3.1.10",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "better-sqlite3": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/ejs": "^3.1.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}