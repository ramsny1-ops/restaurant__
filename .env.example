# Example environment variables for Tableflow
# Copy to .env and edit for your environment. Do NOT commit .env to Git.

# Optional tunnel URL (https origin) when using ngrok. Leave empty when not using.
NGROK_URL=

# Public URL used for QR links and webhook origins (defaults to http://127.0.0.1:PORT)
PUBLIC_URL=

# Server binding
HOST=127.0.0.1
PORT=9367

# SQLite database file path
DATABASE_PATH=./data/tableflow.sqlite

# Cookie security: set to true when serving over HTTPS in production
COOKIE_SECURE=false

# Trust proxy when behind a reverse proxy. Use 'true' or 'false' or a specific value like 'loopback'.
TRUST_PROXY=false

# Optional: a global phone number used for WhatsApp waiter calls (E.164 without +)
WHATSAPP_NUMBER=
